# MAHALO3 Environment Variables

# ── LLM Configuration ────────────────────────────────
# Orchestrator provider (the tool-calling brain). Must support function calling.
#   openrouter | openai -> OpenAI-compatible endpoint (uses OPENAI_* below)
#   bedrock             -> Amazon Bedrock (uses BEDROCK_* below; no API key)
LLM_PROVIDER=openrouter

# Model used by the orchestrator for openrouter/openai. On OpenRouter use a
# namespaced id, e.g. openai/gpt-5-nano or openai/gpt-4o. (Ignored in bedrock
# mode — see BEDROCK_ORCHESTRATOR_MODEL.)
ORCHESTRATOR_MODEL=gpt-4o

# Synthesis (final answer phrasing from tool results): switchable provider.
# SYNTHESIS_PROVIDER: onemin | openai | bedrock
SYNTHESIS_PROVIDER=onemin
# Model for whichever synthesis provider is selected above.
# Valid 1min.ai DeepSeek model ids: deepseek-flash, deepseek-v4-pro.
#SYNTHESIS_MODEL=gpt-4o
SYNTHESIS_MODEL=deepseek-flash

# OpenAI / OpenAI-compatible credentials (REQUIRED for openrouter/openai; NOT
# needed when LLM_PROVIDER=bedrock).
OPENAI_API_KEY=key
OPENAI_BASE_URL=https://api.openai.com/v1

# 1min.ai credentials (REQUIRED when SYNTHESIS_PROVIDER=onemin)
ONEMIN_API_KEY=key
ONEMIN_BASE_URL=https://api.1min.ai

# ── Amazon Bedrock (used when LLM_PROVIDER / SYNTHESIS_PROVIDER = bedrock) ──
# No API key: boto3 resolves AWS credentials from the standard chain (instance
# role, env vars, or a mounted ~/.aws profile). Run with the override:
#   docker compose -f docker-compose.yml -f docker-compose.bedrock.yml up -d
# The chosen orchestrator model MUST support tool calling (e.g. Claude 3.5+).
BEDROCK_REGION=us-east-1
BEDROCK_ORCHESTRATOR_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_SYNTHESIS_MODEL=anthropic.claude-3-5-sonnet-20240620-v1:0
# AWS profile name to use (leave blank for "default"). AWS_PROFILE_DIR points at
# the host dir holding your AWS config/credentials (default ~/.aws; on a Windows
# WorkSpace set it to %USERPROFILE%\.aws).
AWS_PROFILE=
#AWS_PROFILE_DIR=~/.aws

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8008
# Docker: write into the mounted volume so data persists across recreation.
# Non-Docker path: use sqlite:///./mahalo3.db instead.
DATABASE_URL=sqlite:////app/data/mahalo3.db
JWT_SECRET_KEY=your-jwt-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8008
# Host port for the frontend (container always listens on 3000). Override if
# something else already uses 3000 on your machine (e.g. a local dev server).
FRONTEND_PORT=3000

# Mock Services
MOCK_JIRA_HOST=0.0.0.0
MOCK_JIRA_PORT=5001
MOCK_JIRA_TOKEN=mock-jira-token-12345

MOCK_CONFLUENCE_HOST=0.0.0.0
MOCK_CONFLUENCE_PORT=5002
MOCK_CONFLUENCE_TOKEN=mock-confluence-token-12345

MOCK_GITHUB_HOST=0.0.0.0
MOCK_GITHUB_PORT=5003
MOCK_GITHUB_TOKEN=mock-github-token-12345

MOCK_SERVICENOW_HOST=0.0.0.0
MOCK_SERVICENOW_PORT=5004
MOCK_SERVICENOW_TOKEN=mock-servicenow-token-12345

# Mock data persistence: set to true to reset each mock's JSON store back to
# its seed data on startup (useful to get a clean state before a demo).
MOCK_RESET_ON_START=false

# ── Gitea (self-hosted Git server) ───────────────────
# Web UI / REST API exposed on the host at this port (container listens on 3000).
# In-stack, other services reach Gitea at http://gitea:3000.
# GITEA_DOMAIN is the host used in generated links; ROOT_URL must include the
# host-exposed port so UI links resolve correctly from the browser.
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3001/
# Browser-reachable Gitea URL. The adapter rewrites links returned by Gitea
# (which use the in-stack host http://gitea:3000) to this so PR links are
# clickable from the user's browser.
GITEA_PUBLIC_URL=http://localhost:3001

# Gitea bootstrap (one-shot provisioning: admin user + API token + seeded repo).
# These are LOCAL demo credentials for the self-hosted Gitea only — not secrets
# for any real service. Change them if you expose Gitea beyond localhost.
GITEA_ADMIN_USER=mahalo_admin
GITEA_ADMIN_PASSWORD=MahaloDock123!
GITEA_ADMIN_EMAIL=admin@mahalo.local
GITEA_TOKEN_NAME=mahalo-adapter
# Sample repository seeded into Gitea on first boot (something to branch/PR against).
GITEA_SEED_REPO=payment-service

# CORS — browser origins allowed to call the backend (comma-separated).
# Must include the origin your frontend is served from. If you change
# FRONTEND_PORT, add that origin here (e.g. http://localhost:3010).
CORS_ORIGINS=http://localhost:3000,http://localhost:3010
